  m_Name: Data_Purchases_WarmBread
  m_EditorClassIdentifier: UABPetelnia.GGJ2025::UABPetelnia.GGJ2025.Runtime.Settings.PurchaseCollection
  purchases:
  - templateText: "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435! \u0423 \u0432\u0430\u0441 \u0435\u0441\u0442\u044C ${KEYWORD}?"
    keywords:
    - text: "\u0441\u0432\u0435\u0436\u0438\u0439 \u0431\u0430\u0442\u043E\u043D"
      items:
      - {fileID: 11400000, guid: 820a064bd446b174c914e082ca18aa0c, type: 2}
    - text: "\u0440\u0436\u0430\u043D\u043E\u0439 \u0445\u043B\u0435\u0431"
      items:
      - {fileID: 11400000, guid: f1c4c6ef4d598074d89c4b363a15eb60, type: 2}
    - text: "\u043B\u0438\u043C\u043E\u043D\u0430\u0434 \xAB\u0411\u0443\u0440\u0430\u0442\u0438\u043D\u043E\xBB"
      items:
      - {fileID: 11400000, guid: 88811fe3ad064f04cad99ce87afeff12, type: 2}
    - text: "DVD-\u0434\u0438\u0441\u043A"
      items:
      - {fileID: 11400000, guid: 111cd051c46dce747a25ae6a96eee347, type: 2}
    - text: "\u0441\u0442\u0430\u0440\u044B\u0439 \u0442\u0435\u043B\u0435\u0444\u043E\u043D"
      items:
      - {fileID: 11400000, guid: aa26a0a72f73ce043a2f907c57a753b0, type: 2}
    - text: "\u043F\u0438\u0432\u043E"
      items:
      - {fileID: 11400000, guid: 2d273ff84cb579548baa8e619de975db, type: 2}
    - text: "\u043F\u0440\u0435\u0437\u0435\u0440\u0432\u0430\u0442\u0438\u0432\u044B"
      items:
      - {fileID: 11400000, guid: 384e0a13927803f46bd3943a3f8ee317, type: 2}
    - text: "\u043B\u0438\u043C\u043E\u043D\u0430\u0434 \xAB\u0411\u0443\u0440\u0430\u0442\u0438\u043D\u043E\xBB"
      items:
      - {fileID: 11400000, guid: 8023b9585305f5e44880ea79b48cd89b, type: 2}
  - templateText: "\u0414\u043E\u0431\u0440\u044B\u0439 \u0434\u0435\u043D\u044C! ${KEYWORD} \u043D\u0430\u0439\u0434\u0451\u0442\u0441\u044F?"
    keywords:
    - text: "\u0442\u0451\u043F\u043B\u044B\u0439 \u0445\u043B\u0435\u0431"
      items:
      - {fileID: 11400000, guid: 4afa76aff01557b459fe3ce8d2963681, type: 2}
    - text: "\u0431\u0430\u0433\u0435\u0442"
      items:
      - {fileID: 11400000, guid: cb1b48ffe7d78774eaf120733b179d1f, type: 2}
    - text: "\u043C\u043E\u0440\u0441"
      items:
      - {fileID: 11400000, guid: 2acadc075a97723418f45dc4dfbe12ad, type: 2}
    - text: "\u0441\u0442\u0430\u0440\u044B\u0435 \u0434\u0438\u0441\u043A\u0435\u0442\u044B"
      items:
      - {fileID: 11400000, guid: 9675abd1d194b4a4688c1242ebdb07c6, type: 2}
    - text: "\u0442\u0430\u043C\u0430\u0433\u043E\u0447\u0438"
      items:
      - {fileID: 11400000, guid: 8818d5e367d3c7240809f339aa543fc0, type: 2}
    - text: "\u0430\u0441\u043F\u0438\u0440\u0438\u043D"
      items:
      - {fileID: 11400000, guid: 2a3629b18e96c9044aa19fcc5d8e3892, type: 2}
    - text: "\u0436\u0432\u0430\u0447\u043A\u0430 \u0441 \u043A\u0430\u0440\u0442\u0438\u043D\u043A\u0430\u043C\u0438"
      items:
      - {fileID: 11400000, guid: 991c5a7d90ea3894d8f9d2e34245e903, type: 2}
    - text: "\u0433\u0430\u0437\u0438\u0440\u043E\u0432\u043A\u0430"
      items:
      - {fileID: 11400000, guid: b221a383fdb858548b47265abe5f242d, type: 2}
  - templateText: "\u041F\u0440\u0438\u0432\u0435\u0442! \u0415\u0441\u0442\u044C ${KEYWORD}?"
    keywords:
    - text: "\u0431\u0443\u043B\u043E\u0447\u043A\u0430 \u0441 \u043C\u0430\u043A\u043E\u043C"
      items:
      - {fileID: 11400000, guid: 13eea9ccb1d8f81478003a8da4f016ae, type: 2}
    - text: "\u043A\u0440\u0443\u0430\u0441\u0441\u0430\u043D"
      items:
      - {fileID: 11400000, guid: a7921f6f604706b4aaa72d0ef7312d1f, type: 2}
    - text: "\u0437\u0430\u0436\u0438\u0433\u0430\u043B\u043A\u0430"
      items:
      - {fileID: 11400000, guid: b5d310181741d524b903a859bb89f843, type: 2}
    - text: "\u043F\u0435\u0439\u0434\u0436\u0435\u0440"
      items:
      - {fileID: 11400000, guid: 0835d38d261861a49854cdb2dab97f70, type: 2}
    - text: "\u0442\u0435\u0442\u0440\u0438\u0441"
      items:
      - {fileID: 11400000, guid: 4b102eaf284a7964492036abb2d9e7cf, type: 2}
    - text: "\u0432\u043E\u0437\u0434\u0443\u0448\u043D\u044B\u0439 \u0448\u0430\u0440\u0438\u043A"
      items:
      - {fileID: 11400000, guid: cc8debb0c78630c409b8981a3f871247, type: 2}
    - text: "\u0436\u0432\u0430\u0447\u043A\u0430 \xAB\u0425\u0443\u0431\u0431\u0430-\u0411\u0443\u0431\u0431\u0430\xBB"
      items:
      - {fileID: 11400000, guid: 9fc2dd80897834440a05db55254b115e, type: 2}
    - text: "\u0436\u0432\u0430\u0447\u043A\u0430 \xAB\u0417\u043E\u0437\u0443\u043B\u0435\xBB"
      items:
      - {fileID: 11400000, guid: 01909233e3340f242affdc824f410b46, type: 2}
  - templateText: "\u0421\u043B\u044B\u0448\u0430\u043B, \u0443 \u0432\u0430\u0441 \u0442\u0443\u0442 ${KEYWORD}. \u042D\u0442\u043E \u043F\u0440\u0430\u0432\u0434\u0430?"
    keywords:
    - text: "\u0440\u0443\u043C\u044F\u043D\u044B\u0439 \u043F\u0438\u0440\u043E\u0436\u043E\u043A"
      items:
      - {fileID: 11400000, guid: 1cac5432d2f9718448ef9c46ffb0ce39, type: 2}
    - text: "\u0441\u0434\u043E\u0431\u043D\u0430\u044F \u0431\u0443\u043B\u043E\u0447\u043A\u0430"
      items:
      - {fileID: 11400000, guid: e9dae3439a5eaba4db0e8692c8f52b20, type: 2}
    - text: "\u043F\u0430\u0447\u043A\u0430 \u0441\u0438\u0433\u0430\u0440\u0435\u0442 \xAB\u041F\u0440\u0438\u043C\u0430\xBB"
      items:
      - {fileID: 11400000, guid: e989407a44900a24484c9796db302619, type: 2}
    - text: "\u043F\u043B\u0430\u043A\u0430\u0442 \u0441 \u0440\u043E\u043A-\u0433\u0440\u0443\u043F\u043F\u043E\u0439"
      items:
      - {fileID: 11400000, guid: 79e5fe41eab6a9d4ba68b99908caf92c, type: 2}
    - text: "\u043A\u0430\u0440\u0442\u043E\u043D\u043D\u0430\u044F \u043A\u043E\u0440\u043E\u0431\u043A\u0430"
      items:
      - {fileID: 11400000, guid: 801f30f055ad3a8419af88316d8fd2f3, type: 2}
    - text: "\u0442\u0440\u0443\u0431\u043E\u0447\u043A\u0430 \u0434\u043B\u044F \u043F\u0443\u0437\u044B\u0440\u0435\u0439"
      items:
      - {fileID: 11400000, guid: 4ccaf46165f472e4299669290d88a41d, type: 2}
    - text: "\u0436\u0432\u0430\u0447\u043A\u0430 \xABLove is\xBB"
      items:
      - {fileID: 11400000, guid: 04fcf23ca0a9cbe458eb42e6f9338b1a, type: 2}
  - templateText: "\u041C\u043D\u0435 \u0441\u043A\u0430\u0437\u0430\u043B\u0438: \u0442\u0443\u0442 \u0432\u0441\u0435\u0433\u0434\u0430 ${KEYWORD}."
    keywords:
    - text: "\u0432\u0430\u0442\u0440\u0443\u0448\u043A\u0430"
      items:
      - {fileID: 11400000, guid: c50ff5af948dc2e48835a87420cc70cb, type: 2}
    - text: "\u0431\u0443\u0442\u044B\u043B\u043A\u0430 \u043A\u0432\u0430\u0441\u0430"
      items:
      - {fileID: 11400000, guid: be93e27db315b7341a2de8cbf9c7f5d5, type: 2}
    - text: "\u043F\u0430\u0447\u043A\u0430 \u0441\u0438\u0433\u0430\u0440\u0435\u0442 \xAB\u042F\u0432\u0430\xBB"
      items:
      - {fileID: 11400000, guid: 67e1971df701cfd4093100b86bb1541c, type: 2}
    - text: "\u043F\u043B\u0435\u0435\u0440 \u0441 \u043D\u0430\u0443\u0448\u043D\u0438\u043A\u0430\u043C\u0438"
      items:
      - {fileID: 11400000, guid: 290bd2db6d552e240a50b818594735d8, type: 2}
    - text: "\u0431\u0430\u0442\u0430\u0440\u0435\u0439\u043A\u0438"
      items:
      - {fileID: 11400000, guid: 72020ec0dfe286a429a66e4a2e94ee62, type: 2}
    - text: "\u0437\u0443\u0431\u043D\u0430\u044F \u043F\u0430\u0441\u0442\u0430"
      items:
      - {fileID: 11400000, guid: ea65881a8ba18f04cbe706e7ac7e4458, type: 2}
    - text: "\u043C\u0438\u043D\u0435\u0440\u0430\u043B\u044C\u043D\u0430\u044F \u0432\u043E\u0434\u0430"
      items:
      - {fileID: 11400000, guid: 359ee535b4d02194eab0ae7d01dad32d, type: 2}
  - templateText: "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435! \u041F\u043E\u0434\u0441\u043A\u0430\u0436\u0435\u0442\u0435, ${KEYWORD} \u0443 \u0432\u0430\u0441 \u0432 \u043D\u0430\u043B\u0438\u0447\u0438\u0438?"
    keywords:
    - text: "\u043F\u043B\u044E\u0448\u043A\u0430 \u0441 \u043A\u043E\u0440\u0438\u0446\u0435\u0439"
      items:
      - {fileID: 11400000, guid: c499ab930999db7429c8d6da5b4c5d0d, type: 2}
    - text: "\u043A\u0440\u0443\u0436\u043A\u0430 \u0447\u0430\u044F"
      items:
      - {fileID: 11400000, guid: c2b20fb9905fc2d42aa1d124dc015f65, type: 2}
    - text: "\u0441\u0438\u0433\u0430\u0440\u0435\u0442\u0430"
      items:
      - {fileID: 11400000, guid: 413728ead4360cc43a4661a5cc0355fc, type: 2}
    - text: "\u0441\u0442\u0430\u0440\u044B\u0435 \u043A\u0430\u0441\u0441\u0435\u0442\u044B"
      items:
      - {fileID: 11400000, guid: 641c97cfecdc1644890385fb06eb914d, type: 2}
    - text: "\u0438\u0433\u0440\u0438\u0441\u0442\u043E\u0435"
      items:
      - {fileID: 11400000, guid: ce3cbe4343c90ee4485704202b12d020, type: 2}
    - text: "\u0441\u0443\u0445\u0430\u0440\u0438\u043A\u0438"
      items:
      - {fileID: 11400000, guid: 6728c2cb1e80d7845b9607613420df69, type: 2}
    - text: "\u043C\u044B\u043B\u043E"
      items:
      - {fileID: 11400000, guid: 9b4bda098ea53224ba2474e72c92c44e, type: 2}
