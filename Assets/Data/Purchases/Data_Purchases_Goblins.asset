  purchases:
  - templateText: "\u0414\u0438\u043A\u0438\u0439 \u0437\u0435\u043B\u0451\u043D\u044B\u0439 \u0433\u043E\u0431\u043B\u0438\u043D \u043E\u0431\u044A\u044F\u0432\u0438\u043B\u0441\u044F. ${KEYWORD}"
    keywords:
    - text: "\u041E\u043D \u0445\u043E\u0447\u0435\u0442 \u043B\u044E\u0431\u0432\u0438"
      items:
      - {fileID: 11400000, guid: 04fcf23ca0a9cbe458eb42e6f9338b1a, type: 2}
      - {fileID: 11400000, guid: 384e0a13927803f46bd3943a3f8ee317, type: 2}
    - text: "\u041E\u043D \u0445\u043E\u0447\u0435\u0442 \u0447\u0435\u0433\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u043F\u043E\u0441\u043E\u0441\u0430\u0442\u044C"
      items:
      - {fileID: 11400000, guid: 01909233e3340f242affdc824f410b46, type: 2}
      - {fileID: 11400000, guid: 72020ec0dfe286a429a66e4a2e94ee62, type: 2}
      - {fileID: 11400000, guid: 6728c2cb1e80d7845b9607613420df69, type: 2}
      - {fileID: 11400000, guid: 04fcf23ca0a9cbe458eb42e6f9338b1a, type: 2}
  - templateText: "\u0414\u0438\u043A\u0438\u0439 \u0437\u0435\u043B\u0451\u043D\u044B\u0439 \u0433\u043E\u0431\u043B\u0438\u043D \u043E\u0431\u044A\u044F\u0432\u0438\u043B\u0441\u044F. ${KEYWORD}"
    keywords:
    - text: "\u0423\u0433\u0430\u0434\u0430\u0439, \u0447\u0435\u0433\u043E \u043E\u043D \u0445\u043E\u0447\u0435\u0442."
      items:
      - {fileID: 11400000, guid: 2a3629b18e96c9044aa19fcc5d8e3892, type: 2}
      - {fileID: 11400000, guid: 359ee535b4d02194eab0ae7d01dad32d, type: 2}
