      - {fileID: 11400000, guid: b221a383fdb858548b47265abe5f242d, type: 2}
      - {fileID: 11400000, guid: 01909233e3340f242affdc824f410b46, type: 2}
    - text: "\u041E\u043D \u0445\u043E\u0447\u0435\u0442 \u043D\u0430\u0434\u0443\u0432\u043D\u043E\u0433\u043E \u0434\u0440\u0443\u0433\u0430."
      items:
      - {fileID: 11400000, guid: cc8debb0c78630c409b8981a3f871247, type: 2}
      - {fileID: 11400000, guid: 384e0a13927803f46bd3943a3f8ee317, type: 2}
  - templateText: "\u0414\u0438\u043A\u0438\u0439 \u0437\u0435\u043B\u0451\u043D\u044B\u0439 \u0433\u043E\u0431\u043B\u0438\u043D \u043E\u0431\u044A\u044F\u0432\u0438\u043B\u0441\u044F. ${KEYWORD}"
    keywords:
    - text: "\u0417\u0435\u043B\u0451\u043D\u044B\u0439, \u043D\u043E \u043D\u0435 \u0442\u0440\u0430\u0432\u0430, \u0441 \u0445\u0432\u043E\u0441\u0442\u043E\u043C, \u043D\u043E \u043D\u0435 \u043C\u044B\u0448\u044C."
      items:
      - {fileID: 11400000, guid: 384e0a13927803f46bd3943a3f8ee317, type: 2}
    - text: "\u0415\u0441\u043B\u0438 \u0443 \u0442\u0435\u0431\u044F \u0437\u0435\u043B\u0435\u043D\u043E \u0432 \u0433\u043B\u0430\u0437\u0430\u0445, \u044D\u0442\u043E \u0435\u0449\u0451 \u043D\u0435 \u0437\u043D\u0430\u0447\u0438\u0442, \u0447\u0442\u043E \u043F\u0440\u0438\u0448\u043B\u0430 \u0432\u0435\u0441\u043D\u0430."
      items:
      - {fileID: 11400000, guid: 2a3629b18e96c9044aa19fcc5d8e3892, type: 2}
