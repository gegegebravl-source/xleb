      - {fileID: 11400000, guid: b221a383fdb858548b47265abe5f242d, type: 2}
    - text: "\u0445\u043E\u0447\u0435\u0442\u0441\u044F \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0441\u043D\u043E\u0432\u0430 \u0440\u0430\u0437\u043E\u0433\u043D\u0430\u0442\u044C\u0441\u044F"
