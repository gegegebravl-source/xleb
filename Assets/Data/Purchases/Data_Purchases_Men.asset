      - {fileID: 11400000, guid: 9b4bda098ea53224ba2474e72c92c44e, type: 2}
    - text: "\u043F\u043B\u0430\u043D\u0438\u0440\u0443\u044E \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0432\u0435\u0447\u0435\u0440\u043E\u043C \u0440\u0430\u0437\u0432\u043B\u0435\u0447\u044C\u0441\u044F"
