  - templateText: "\u0427\u0442\u043E-\u0442\u043E \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0432\u0441\u0451 \u0432\u0430\u043B\u0438\u0442\u0441\u044F \u0438\u0437 \u0440\u0443\u043A, \u0434\u0430 \u0435\u0449\u0451 \u0438 ${KEYWORD}. \u0415\u0441\u0442\u044C \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u043F\u043E\u043C\u043E\u0433\u0430\u044E\u0449\u0435\u0435?"
    keywords:
    - text: "\u0433\u043E\u043B\u043E\u0432\u0430 \u0442\u0440\u0435\u0449\u0438\u0442"
      items:
      - {fileID: 11400000, guid: 2a3629b18e96c9044aa19fcc5d8e3892, type: 2}
    - text: "\u0436\u0435\u043D\u0430 \u0437\u043B\u0438\u0442\u0441\u044F"
      items:
      - {fileID: 11400000, guid: ce3cbe4343c90ee4485704202b12d020, type: 2}
      - {fileID: 11400000, guid: 2d273ff84cb579548baa8e619de975db, type: 2}
    - text: "\u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E, \u043D\u0443\u0436\u043D\u0430 \u043F\u0440\u043E\u0444\u0438\u043B\u0430\u043A\u0442\u0438\u043A\u0430"
      items:
      - {fileID: 11400000, guid: ea65881a8ba18f04cbe706e7ac7e4458, type: 2}
      - {fileID: 11400000, guid: 9b4bda098ea53224ba2474e72c92c44e, type: 2}
  - templateText: "\u042F \u0412\u0438\u0442\u0430\u043B\u0438\u0439, \u043C\u043D\u0435 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C. \u041B\u044E\u0431\u043B\u044E \u0447\u0435\u0448\u0443 \u0434\u0435\u0432\u0447\u043E\u043D\u043E\u043A. \u0415\u0441\u043B\u0438 \u0434\u0435\u0432\u0447\u043E\u043D\u043A\u0430 \u0441\u0442\u0440\u0430\u0448\u043D\u0430\u044F \u2014 \u0445\u043E\u0442\u044C \u043F\u043E\u0431\u0430\u0437\u0430\u0440\u0438\u043C. \u041D\u0443 \u0447\u0442\u043E, \u043C\u0430\u043B\u0430\u044F, \u0441\u0435\u0439\u0447\u0430\u0441 \u0441\u043F\u043E\u044E ${KEYWORD}"
    keywords:
    - text: "\u041A\u0443 \u041A\u0430 \u0420\u0435 \u041A\u0438"
      items:
      - {fileID: 11400000, guid: 2a3629b18e96c9044aa19fcc5d8e3892, type: 2}
    - text: "\u042B \u0433\u0430 \u0433\u0430"
      items:
      - {fileID: 11400000, guid: 2a3629b18e96c9044aa19fcc5d8e3892, type: 2}
    - text: "\u041C\u0443\u0443\u0443\u0443\u0443\u0443\u0443\u0443"
      items:
      - {fileID: 11400000, guid: 2a3629b18e96c9044aa19fcc5d8e3892, type: 2}
  - templateText: "\u042F \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u043F\u0438\u043B. ${KEYWORD}"
    keywords:
    - text: "\u041D\u0430 \u0440\u0430\u0431\u043E\u0442\u0435, \u0447\u0443\u0442\u044C-\u0447\u0443\u0442\u044C, \u0441\u0430\u043C\u0443\u044E \u043C\u0430\u043B\u043E\u0441\u0442\u044C \u0432\u044B\u043F\u0438\u043B \u0438 \u043F\u043E\u0435\u0445\u0430\u043B \u0434\u043E\u043C\u043E\u0439. \u0418 \u0432\u043E\u0434\u043A\u0443 \u0432\u044B\u043F\u0438\u043B, \u0438 \u0432\u0438\u043D\u043E, \u0438 \u0447\u0435\u043A\u0443\u0448\u043A\u0443 \u043E\u0434\u043D\u0443"
      items:
      - {fileID: 11400000, guid: 2d273ff84cb579548baa8e619de975db, type: 2}
      - {fileID: 11400000, guid: ce3cbe4343c90ee4485704202b12d020, type: 2}
    - text: "\u0421\u043E\u0432\u0441\u0435\u043C \u0431\u044B \u0447\u0435\u0433\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u0441\u043B\u0430\u0434\u043A\u043E\u0433\u043E"
      items:
      - {fileID: 11400000, guid: 8023b9585305f5e44880ea79b48cd89b, type: 2}
      - {fileID: 11400000, guid: 359ee535b4d02194eab0ae7d01dad32d, type: 2}
      - {fileID: 11400000, guid: ce3cbe4343c90ee4485704202b12d020, type: 2}
    - text: "\u0410 \u0435\u0441\u0442\u044C \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u043C\u0443\u0436\u0441\u043A\u043E\u0435?"
