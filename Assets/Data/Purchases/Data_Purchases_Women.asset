  m_Name: Data_Purchases_Women
  m_EditorClassIdentifier: 
  purchases:
  - templateText: "\u0417\u0434\u043E\u0440\u043E\u0432\u043E! \u0421\u043C\u043E\u0442\u0440\u0435\u043B\u0430 \u0432\u0447\u0435\u0440\u0430 \xAB\u0414\u0438\u043A\u0430\u0440\u043A\u0443\xBB? \u0411\u043E\u0436\u0435, \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u044C: \u0420\u043E\u0441\u0430\u0443\u0440\u0430 \u0432\u0445\u043E\u0434\u0438\u0442 \u0432 \u043F\u043E\u043C\u0435\u0441\u0442\u044C\u0435 \u0410\u0440\u0438\u0441\u0442\u0438\u043C\u0435\u043D\u0434\u0438 \u043F\u0440\u044F\u043C\u043E \u0441 \u041F\u0430\u043D\u043E\u0440\u0430\u043C\u044B. \u0412\u043E\u043B\u043E\u0441\u044B \u2014 \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u043E \u043F\u0440\u044F\u043C\u044B\u0435, \u043C\u0430\u043A\u0438\u044F\u0436 \u0440\u043E\u0441\u043A\u043E\u0448\u043D\u044B\u0439, \u0430 \u043F\u043B\u0430\u0442\u044C\u0435 \u2014 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0430\u044F \u0441\u0442\u0438\u043B\u0435\u0432\u0430\u044F \u0431\u043E\u043C\u0431\u0430! \u0410\u0440\u0438\u0441\u0442\u0438\u043C\u0435\u043D\u0434\u0438 \u0437\u0430\u0441\u0442\u044B\u043B\u0438, \u041B\u0443\u0438\u0441 \u041C\u0430\u0440\u0438\u043E \u0447\u0443\u0442\u044C \u043D\u0435 \u043F\u043B\u0430\u0447\u0435\u0442 \u043E\u0442 \u0448\u043E\u043A\u0430. \u0420\u043E\u0441\u0430\u0443\u0440\u0430 \u0431\u0440\u043E\u0441\u0430\u0435\u0442 \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u0439 \u0432\u0437\u0433\u043B\u044F\u0434: \u0442\u0435\u043F\u0435\u0440\u044C \u043A\u043E\u043C\u0430\u043D\u0434\u0443\u044E \u044F, \u0430 \u0432\u044B? \u0412\u044B \u2014 \u043D\u0438\u043A\u0442\u043E. ${KEYWORD}"
    keywords:
    - text: "\u0416\u0432\u0430\u0447\u043A\u0443 \u043C\u043D\u0435"
      items:
      - {fileID: 11400000, guid: 04fcf23ca0a9cbe458eb42e6f9338b1a, type: 2}
      - {fileID: 11400000, guid: 9fc2dd80897834440a05db55254b115e, type: 2}
    - text: "\u041A\u043E\u043D\u0444\u0435\u0442\u0443 \u043C\u043D\u0435"
      items:
      - {fileID: 11400000, guid: 01909233e3340f242affdc824f410b46, type: 2}
  - templateText: "\u041F\u0440\u0438\u0432\u0435\u0442! \u041D\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u044E, \u043A\u0430\u043A\u043E\u0439 \u0438\u0434\u0438\u043E\u0442 \u043C\u043E\u0436\u0435\u0442 \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u044D\u0442\u0443 \xAB\u0414\u0438\u043A\u0430\u0440\u043A\u0443\xBB. \u0420\u043E\u0441\u0430\u0443\u0440\u0430 \u0432\u0435\u0447\u043D\u043E \u0438\u0433\u0440\u0430\u0435\u0442 \u043D\u0430\u043F\u044B\u0449\u0435\u043D\u043D\u0443\u044E \u0436\u0435\u0440\u0442\u0432\u0443, \u0430 \u0432\u0441\u044F \u0434\u0440\u0430\u043C\u0430 \u2014 \u043D\u0435\u0440\u0435\u0430\u043B\u0438\u0441\u0442\u0438\u0447\u043D\u0430\u044F \u0438 \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0442\u0435\u0430\u0442\u0440\u0430\u043B\u044C\u043D\u0430\u044F. \u0415\u0451 \u043C\u0435\u0441\u0442\u044C \u0438 \u043B\u044E\u0431\u043E\u0432\u044C\u2026 \u043E\u0447\u0435\u043D\u044C \u0434\u0435\u0448\u0451\u0432\u043E\u0433\u043E \u0443\u0440\u043E\u0432\u043D\u044F. ${KEYWORD}"
    keywords:
    - text: "\u041D\u0435\u043A\u0430\u043B\u043E\u0440\u0438\u0439\u043D\u0443\u044E \u0436\u0432\u0430\u0447\u043A\u0443 \u043C\u043D\u0435"
      items:
      - {fileID: 11400000, guid: 991c5a7d90ea3894d8f9d2e34245e903, type: 2}
    - text: "\u041B\u0435\u0434\u0435\u043D\u0446\u044B \u043C\u043D\u0435"
      items:
      - {fileID: 11400000, guid: 6728c2cb1e80d7845b9607613420df69, type: 2}
  - templateText: "\u0421\u0432\u0435\u0442\u0438\u0442? \u0421\u0432\u0435\u0442\u0438\u0442? ${KEYWORD}"
    keywords:
    - text: "\u0421\u0432\u0435\u0442\u0438\u0442? \u0421\u0432\u0435\u0442\u0438\u0442?"
      items:
      - {fileID: 11400000, guid: ce3cbe4343c90ee4485704202b12d020, type: 2}
    - text: "\u0421\u0432\u0435\u0442\u0438\u0442? \u0425\u0430-\u0445\u0430. \u041A\u0440\u0430\u0441\u0438\u0432\u043E \u0441\u0432\u0435\u0442\u0438\u0442"
      items:
      - {fileID: 11400000, guid: ce3cbe4343c90ee4485704202b12d020, type: 2}
  - templateText: "\u0417\u0434\u043E\u0440\u043E\u0432\u043E. \u0418\u0434\u0443 \u043D\u0430 \u0434\u0435\u043D\u044C \u0440\u043E\u0436\u0434\u0435\u043D\u0438\u044F \u043A \u043F\u043E\u0434\u0440\u0443\u0433\u0435, ${KEYWORD}"
    keywords:
    - text: "\u043C\u043E\u0436\u0435\u0442, \u043F\u043E\u0441\u043E\u0432\u0435\u0442\u0443\u0435\u0442\u0435, \u0447\u0442\u043E \u0432\u0437\u044F\u0442\u044C \u0432 \u043F\u043E\u0434\u0430\u0440\u043E\u043A?"
      items:
      - {fileID: 11400000, guid: ce3cbe4343c90ee4485704202b12d020, type: 2}
      - {fileID: 11400000, guid: cc8debb0c78630c409b8981a3f871247, type: 2}
      - {fileID: 11400000, guid: 01909233e3340f242affdc824f410b46, type: 2}
      - {fileID: 11400000, guid: 04fcf23ca0a9cbe458eb42e6f9338b1a, type: 2}
    - text: "\u043C\u043E\u0436\u0435\u0442, \u043F\u043E\u0441\u043E\u0432\u0435\u0442\u0443\u0435\u0442\u0435 \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u0441\u043C\u0435\u0448\u043D\u043E\u0435 \u0432 \u043F\u043E\u0434\u0430\u0440\u043E\u043A?"
      items:
      - {fileID: 11400000, guid: ea65881a8ba18f04cbe706e7ac7e4458, type: 2}
      - {fileID: 11400000, guid: 9b4bda098ea53224ba2474e72c92c44e, type: 2}
  - templateText: "\u0417\u0434\u043E\u0440\u043E\u0432\u043E. \u0412\u0447\u0435\u0440\u0430 \u043F\u0440\u043E\u0431\u043E\u0432\u0430\u043B\u0430 \u0442\u0430\u043A\u043E\u0439 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u044B\u0439 \u043A\u043E\u043A\u0442\u0435\u0439\u043B\u044C. \u0421\u043F\u0440\u0430\u0439\u0442 \u0438 \u0441\u0438\u0440\u043E\u043F \u043E\u0442 \u043A\u0430\u0448\u043B\u044F. ${KEYWORD}"
    keywords:
    - text: "\u041C\u043E\u0436\u0435\u0442, \u043F\u043E\u0441\u043E\u0432\u0435\u0442\u0443\u0435\u0442\u0435 \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u043F\u043E\u0445\u043E\u0436\u0435\u0435?"
      items:
      - {fileID: 11400000, guid: ce3cbe4343c90ee4485704202b12d020, type: 2}
