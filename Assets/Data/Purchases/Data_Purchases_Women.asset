      - {fileID: 11400000, guid: 01909233e3340f242affdc824f410b46, type: 2}
  - templateText: "\u041F\u0440\u0438\u0432\u0435\u0442. \u0417\u043D\u0430\u0435\u0448\u044C, \u0432\u0447\u0435\u0440\u0430 \u0447\u0438\u0442\u0430\u043B\u0430 \u0441\u0432\u043E\u0439 \u0433\u043E\u0440\u043E\u0441\u043A\u043E\u043F \u0438 \u043F\u043E\u043D\u044F\u043B\u0430, \u0447\u0442\u043E \u043E\u0431\u044F\u0437\u0430\u043D\u0430 \u043A\u043E\u0435-\u0447\u0442\u043E \u043A\u0443\u043F\u0438\u0442\u044C. \u042F ${KEYWORD}"
