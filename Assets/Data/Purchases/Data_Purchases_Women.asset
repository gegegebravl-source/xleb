      - {fileID: 11400000, guid: 8023b9585305f5e44880ea79b48cd89b, type: 2}
    - text: "\u0410 \u043C\u043E\u0436\u043D\u043E \u0430\u0441\u043F\u0438\u0440\u0438\u043D?"
      items:
      - {fileID: 11400000, guid: 2a3629b18e96c9044aa19fcc5d8e3892, type: 2}
  - templateText: "\u041F\u0440\u0438\u0432\u0435\u0442. \u0413\u043E\u0432\u043E\u0440\u044F\u0442, \u0443 TicTac \u0432\u0441\u0435\u0433\u043E \u0434\u0432\u0435 \u043A\u0430\u043B\u043E\u0440\u0438\u0438. \u0425\u043E\u0442\u0435\u043B\u043E\u0441\u044C \u0431\u044B \u0447\u0435\u0433\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u043F\u043E\u0441\u044B\u0442\u043D\u0435\u0435, ${KEYWORD}"
    keywords:
    - text: "\u041C\u043E\u0436\u0435\u0442, \u0435\u0441\u0442\u044C \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u043D\u0430 5-15 \u043A\u0430\u043B\u043E\u0440\u0438\u0439?"
      items:
      - {fileID: 11400000, guid: 991c5a7d90ea3894d8f9d2e34245e903, type: 2}
    - text: "\u041C\u043E\u0436\u0435\u0442, \u0435\u0441\u0442\u044C \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u043D\u0430 10-20 \u043A\u0430\u043B\u043E\u0440\u0438\u0439?"
      items:
      - {fileID: 11400000, guid: 04fcf23ca0a9cbe458eb42e6f9338b1a, type: 2}
    - text: "\u041C\u043E\u0436\u0435\u0442, \u0435\u0441\u0442\u044C \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u043D\u0430 25-30 \u043A\u0430\u043B\u043E\u0440\u0438\u0439?"
      items:
      - {fileID: 11400000, guid: 9fc2dd80897834440a05db55254b115e, type: 2}
    - text: "\u043C\u043E\u0436\u0435\u0442, \u0435\u0441\u0442\u044C \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u043D\u0430 50-70 \u043A\u0430\u043B\u043E\u0440\u0438\u0439?"
