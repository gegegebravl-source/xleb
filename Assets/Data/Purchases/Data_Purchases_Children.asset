  purchases:
  - templateText: "\u041F\u0440\u0438\u0432\u0435\u0442, \u0434\u044F\u0434\u044F! \u0421\u0435\u0433\u043E\u0434\u043D\u044F \u043C\u0430\u043C\u0430 \u043E\u043F\u044F\u0442\u044C \u043D\u0430 \u0440\u0430\u0431\u043E\u0442\u0443 \u043D\u0435 \u0432\u0441\u0442\u0430\u043B\u0430. ${KEYWORD}"
    keywords:
    - text: "\u041F\u043E\u0447\u0435\u043C\u0443 \u043D\u0435 \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C \u043D\u043E\u0447\u0435\u0432\u0430\u0442\u044C?"
      items: []
    - text: "\u041F\u0430\u043F\u0430 \u043F\u043E\u0441\u043B\u0430\u043B \u043A\u0443\u043F\u0438\u0442\u044C \u043F\u043E\u043F\u0438\u0442\u044C \u043E\u0442 \u043F\u043E\u0445\u043C\u0435\u043B\u044C\u044F"
      items:
      - {fileID: 11400000, guid: 2d273ff84cb579548baa8e619de975db, type: 2}
      - {fileID: 11400000, guid: 2a3629b18e96c9044aa19fcc5d8e3892, type: 2}
      - {fileID: 11400000, guid: b221a383fdb858548b47265abe5f242d, type: 2}
      - {fileID: 11400000, guid: ce3cbe4343c90ee4485704202b12d020, type: 2}
  - templateText: "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435. \u0425\u043E\u0442\u0435\u043B \u0431\u044B \u0436\u0432\u0430\u0447\u043A\u0443 Dragon Ball Z. ${KEYWORD}"
    keywords:
    - text: "\u0414\u0430\u0439\u0442\u0435 \u0437\u0430 \u0432\u0441\u0451, \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0441\u044F"
      items:
      - {fileID: 11400000, guid: 991c5a7d90ea3894d8f9d2e34245e903, type: 2}
  - templateText: "\u041F\u0440\u0438\u0432\u0435\u0442, \u0434\u044F\u0434\u044F! \u041C\u0430\u043C\u0430 \u0432\u0435\u043B\u0435\u043B\u0430 \u043A\u0443\u043F\u0438\u0442\u044C \u043C\u044B\u043B\u0430. ${KEYWORD}"
    keywords:
    - text: "\u041D\u0430\u0434\u043E \u043F\u043E\u0441\u0443\u0434\u0443 \u043C\u044B\u0442\u044C, \u0435\u0441\u043B\u0438 \u043E\u0441\u0442\u0430\u043D\u0435\u0442\u0441\u044F \u2014 \u0438 \u0431\u0440\u0430\u0442\u0430 \u043F\u043E\u043C\u043E\u0435\u043C."
      items:
      - {fileID: 11400000, guid: 9b4bda098ea53224ba2474e72c92c44e, type: 2}
    - text: "\u041D\u0435 \u043B\u044E\u0431\u043E\u0433\u043E, \u0430 \u0441 \u043F\u0443\u0437\u044B\u0440\u044C\u043A\u0430\u043C\u0438"
      items:
      - {fileID: 11400000, guid: 359ee535b4d02194eab0ae7d01dad32d, type: 2}
      - {fileID: 11400000, guid: ce3cbe4343c90ee4485704202b12d020, type: 2}
      - {fileID: 11400000, guid: 2d273ff84cb579548baa8e619de975db, type: 2}
      - {fileID: 11400000, guid: 4ccaf46165f472e4299669290d88a41d, type: 2}
      - {fileID: 11400000, guid: 8023b9585305f5e44880ea79b48cd89b, type: 2}
      - {fileID: 11400000, guid: b221a383fdb858548b47265abe5f242d, type: 2}
  - templateText: "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435, \u0434\u044F\u0434\u044F. \u041F\u043E\u0447\u0435\u043C\u0443 \u043B\u0430\u0440\u0451\u043A \u0432\u0447\u0435\u0440\u0430 \u043D\u0435 \u0440\u0430\u0431\u043E\u0442\u0430\u043B? ${KEYWORD}"
    keywords:
    - text: "\u0425\u043E\u0442\u0435\u043B \u0431\u044B \u043F\u043E\u0434\u0443\u0434\u0435\u0442\u044C. \u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u044F \u043E\u0442 \u044D\u0442\u043E\u0433\u043E \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u044B\u0439"
      items:
      - {fileID: 11400000, guid: cc8debb0c78630c409b8981a3f871247, type: 2}
      - {fileID: 11400000, guid: 4ccaf46165f472e4299669290d88a41d, type: 2}
      - {fileID: 11400000, guid: 9fc2dd80897834440a05db55254b115e, type: 2}
      - {fileID: 11400000, guid: 04fcf23ca0a9cbe458eb42e6f9338b1a, type: 2}
    - text: "\u041C\u0430\u043C\u0430 \u0441 \u043F\u0430\u043F\u043E\u0439 \u0432\u0442\u043E\u0440\u044B\u0435 \u0441\u0443\u0442\u043A\u0438 \u0441 \u043A\u0440\u043E\u0432\u0430\u0442\u0438 \u043D\u0435 \u0432\u0441\u0442\u0430\u044E\u0442. \u0414\u0430\u043B\u0438 \u0431\u0443\u043C\u0430\u0436\u043A\u0443, \u0447\u0442\u043E \u043A\u0443\u043F\u0438\u0442\u044C"
      items:
      - {fileID: 11400000, guid: 2d273ff84cb579548baa8e619de975db, type: 2}
      - {fileID: 11400000, guid: 2a3629b18e96c9044aa19fcc5d8e3892, type: 2}
      - {fileID: 11400000, guid: b221a383fdb858548b47265abe5f242d, type: 2}
      - {fileID: 11400000, guid: ce3cbe4343c90ee4485704202b12d020, type: 2}
  - templateText: "\u041F\u0440\u0438\u0432\u0435\u0442, \u0434\u044F\u0434\u044F. \u041C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E ${KEYWORD}"
    keywords:
    - text: "\u041F\u044F\u0442\u044C \u0437\u0430 \u0440\u0443\u0431\u043B\u044C, \u043E\u0434\u043D\u043E \u0441 \u0447\u0435\u0441\u043D\u043E\u043A\u043E\u043C. \u0410\u0440\u043E\u043C\u0430\u0442\u043E\u043C \u043D\u0430\u043F\u043E\u043B\u043D\u0438\u0442 \u0432\u0441\u044E \u0445\u0430\u0442\u0443. \u0427\u0435\u0441\u043D\u043E\u0447\u043D\u043E\u0435 \u2014 \u0447\u0442\u043E\u0431\u044B \u0434\u043E\u0447\u0435\u0440\u0438 \u0432\u044B\u0445\u043E\u0434\u0438\u043B\u0438 \u0437\u0430\u043C\u0443\u0436. \u0414\u0435\u0433\u0442\u044F\u0440\u043D\u043E\u0435 \u2014 \u0447\u0442\u043E\u0431\u044B \u0432\u0441\u0435 \u043B\u044E\u0431\u0438\u043B\u0438. \u0421\u043A\u0438\u043F\u0438\u0434\u0430\u0440\u043D\u043E\u0435 \u2014 \u0447\u0442\u043E\u0431\u044B \u043C\u043E\u043B\u044C \u043C\u0435\u0445\u0430 \u043D\u0435 \u0435\u043B\u0430. \u0417\u043D\u0430\u0435\u0448\u044C \u043B\u0438, \u043C\u0438\u043B\u044B\u0439 \u0440\u0435\u0431\u0451\u043D\u043E\u043A, \u0447\u0435\u0433\u043E \u0442\u0435\u0431\u0435 \u043D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442, \u0447\u0442\u043E \u0442\u0435\u0431\u0435 \u043D\u0443\u0436\u043D\u043E, \u0447\u0442\u043E\u0431\u044B \u0432\u044B\u0440\u0430\u0441\u0442\u0438 \u0437\u0434\u043E\u0440\u043E\u0432\u044B\u043C \u043C\u0443\u0436\u0438\u043A\u043E\u043C."
      items:
      - {fileID: 11400000, guid: 9b4bda098ea53224ba2474e72c92c44e, type: 2}
    - text: "- \u0417\u0434\u043E\u0440\u043E\u0432\u043E, \u043C\u0438\u0441\u0442\u0435\u0440 \u041B\u044B\u0441\u044B\u0439!"
      items:
      - {fileID: 11400000, guid: ea65881a8ba18f04cbe706e7ac7e4458, type: 2}
  - templateText: "\u041A\u0443\u0434\u0430 \u0443\u0441\u0442\u0430\u0432\u0438\u043B\u0441\u044F ${KEYWORD}"
    keywords:
    - text: "\u043D\u0430 \u044F\u0431\u043B\u043E\u043A\u043E"
      items: []
    - text: "\u0432 \u0441\u043E\u043F\u043B\u0438"
      items: []
  - templateText: "\u041F\u0440\u0438\u0432\u0435\u0442, \u0434\u044F\u0434\u044F! \u0415\u0449\u0451 \u043D\u0435 \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u043F\u043E\u0434\u0437\u0430\u0442\u044B\u043B\u044C\u043D\u0438\u043A? ${KEYWORD}"
    keywords:
    - text: "\u041F\u0440\u043E\u0434\u0430\u0439 \u0432\u044B\u043F\u0438\u0442\u044C \u2014 \u0438 \u0431\u0438\u0442\u044C \u043D\u0435 \u0431\u0443\u0434\u0443."
      items:
      - {fileID: 11400000, guid: 2d273ff84cb579548baa8e619de975db, type: 2}
      - {fileID: 11400000, guid: ce3cbe4343c90ee4485704202b12d020, type: 2}
    - text: "\u0421\u0435\u0439\u0447\u0430\u0441 \u043F\u043E\u043B\u0443\u0447\u0438\u0448\u044C"
      items: []
  - templateText: "\u0416\u0430\u0440\u043A\u0438\u0439 \u0434\u0435\u043D\u044C, \u0441\u043A\u0430\u0436\u0443 \u044F. \u041F\u043E\u043F\u0438\u0442\u044C \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0435\u0441\u0442\u044C \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C? ${KEYWORD}"
    keywords:
    - text: "\u0413\u0430\u0437\u0438\u0440\u043E\u0432\u043A\u0438?"
      items:
      - {fileID: 11400000, guid: 359ee535b4d02194eab0ae7d01dad32d, type: 2}
    - text: "\u041F\u0438\u0432\u0430?"
      items:
      - {fileID: 11400000, guid: 2d273ff84cb579548baa8e619de975db, type: 2}
    - text: "\u0428\u0430\u043C\u043F\u0430\u043D\u0441\u043A\u043E\u0433\u043E??"
      items:
      - {fileID: 11400000, guid: ce3cbe4343c90ee4485704202b12d020, type: 2}
  - templateText: "\u0410 \u043A\u043B\u0435\u0439 \u0443 \u0432\u0430\u0441 \u0435\u0441\u0442\u044C? ${KEYWORD}"
    keywords:
    - text: "\u0410 \u0435\u0441\u0442\u044C \u0447\u0435\u043C \u043F\u043E\u043D\u044E\u0445\u0430\u0442\u044C?"
      items:
      - {fileID: 11400000, guid: 01909233e3340f242affdc824f410b46, type: 2}
    - text: "\u0410 \u043C\u043E\u0436\u0435\u0442, \u0447\u0435\u043C \u043F\u043E\u0434\u0443\u0434\u0435\u0442\u044C?"
      items:
      - {fileID: 11400000, guid: cc8debb0c78630c409b8981a3f871247, type: 2}
      - {fileID: 11400000, guid: 4ccaf46165f472e4299669290d88a41d, type: 2}
  - templateText: "\u0414\u043E\u0431\u0440\u044B\u0439 \u0434\u0435\u043D\u044C \u0441 \u043A\u0443\u0440\u043E\u0447\u043A\u043E\u0439. \u0425\u043E\u0442\u0435\u043B \u0431\u044B \u0441\u043B\u0430\u0434\u043A\u043E\u0433\u043E ${KEYWORD}"
    keywords:
    - text: "\u0418\u0437 \u0410\u043C\u0435\u0440\u0438\u043A\u0438"
      items:
      - {fileID: 11400000, guid: 9fc2dd80897834440a05db55254b115e, type: 2}
    - text: "\u0418\u0437 \u0418\u0441\u043F\u0430\u043D\u0438\u0438"
      items:
      - {fileID: 11400000, guid: 6728c2cb1e80d7845b9607613420df69, type: 2}
    - text: "\u0418\u0437 \u041F\u043E\u043B\u044C\u0448\u0438"
      items:
      - {fileID: 11400000, guid: 01909233e3340f242affdc824f410b46, type: 2}
  - templateText: "\u0414\u043E\u0431\u0440\u043E\u0435 \u0443\u0442\u0440\u043E \u0437\u0430\u043A\u0440\u0443\u0447\u0435\u043D\u043D\u043E\u0435. \u0425\u043E\u0442\u0435\u043B \u0431\u044B ${KEYWORD}"
    keywords:
    - text: "\u043D\u0435\u043A\u0430\u043B\u043E\u0440\u0438\u0439\u043D\u043E\u0439 \u0436\u0432\u0430\u0447\u043A\u0438"
      items:
      - {fileID: 11400000, guid: 991c5a7d90ea3894d8f9d2e34245e903, type: 2}
    - text: "\u043A\u0430\u043B\u043E\u0440\u0438\u0439\u043D\u043E\u0439 \u043A\u043E\u043D\u0444\u0435\u0442\u043A\u0438 \u0434\u043B\u044F \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u044F"
      items:
      - {fileID: 11400000, guid: 01909233e3340f242affdc824f410b46, type: 2}
      - {fileID: 11400000, guid: 6728c2cb1e80d7845b9607613420df69, type: 2}
